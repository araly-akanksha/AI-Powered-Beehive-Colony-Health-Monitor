# ============================================================
# .gitignore — Beehive Health Monitoring Project
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
*.spec

# Virtual environments
venv/
.venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw audio is large, never commit it
data/raw/
data/processed/*.csv
*.wav
*.mp3
*.flac
*.ogg

# Whitelist lightweight curated demo clips (~187 KB each) for Vercel deployment
!backend/samples/*.wav
!frontend/public/samples/*.wav

# Scratch & temporary backups
frontend/src_v1_backup/
scratch/

# Model weights
checkpoints/
*.pt
*.pth
*.onnx

# Weights & Biases
wandb/
.wandb/

# Logs
logs/
*.log
training_log.csv

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user
