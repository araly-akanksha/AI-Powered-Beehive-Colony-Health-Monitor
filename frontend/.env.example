# Copy this file to .env and adjust as needed.

# true  -> app runs fully self-contained, no backend needed (rehearsal / fallback)
# false -> app calls your FastAPI backend at VITE_API_BASE_URL
VITE_DEMO_MODE=true

# Only used when VITE_DEMO_MODE=false. In dev, requests to /api are proxied
# to http://localhost:8000 by vite.config.js, so the default below usually
# needs no change during local development.
VITE_API_BASE_URL=/api
